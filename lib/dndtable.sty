\ExplSyntaxOn

% Fix for \rowcolors ignoring the "first row" field, as per:
% https://tex.stackexchange.com/a/297357/2575
\newcounter{tblerows}
\expandafter\let\csname c@tblerows\endcsname\rownum

% Special Columns
\newcolumntype {Y} { > {\centering\arraybackslash } X }
\newcolumntype {`} { > {\global\let\currentrowstyle\relax } }
\newcolumntype {^} { > {\currentrowstyle} }

% Add an extra pixel to row height to give a little extra breathing room.
% Unfortunately this adds to top and bottom, whereas just top would be
% preferable...
\setlength\extrarowheight{1pt}

% Matches {, }, >,  , and any other character
\regex_const:Nn \c__preamble_regex {>\s*{.*}\s*\S|\S}

\newcommand{\rowstyle}[1]
  {
    \gdef\currentrowstyle{#1}#1\ignorespaces
  }

% Table options
\keys_define:nn { dnd / table }
  {
    color .tl_set:N            = \l__dnd_table_color_tl,
    color .initial:n           = tablecolor,
    color .value_required:n    = true,
    header .tl_set:N           = \l__dnd_table_header_tl,
    header .value_required:n   = true,
    bold .tl_set:N             = \l__dnd_table_bold_tl,
    bold .value_required:n     = true,
    bold .initial:n            = true,
    width .dim_set:N           = \l__dnd_table_width_dim,
    width .value_required:n    = true,
  }

% Table Definition
\NewDocumentEnvironment {DndTable} { o m }
{
  \group_begin:

  \dim_set:Nn \l__dnd_table_width_dim { \linewidth }
  \tl_if_novalue:nF {#1}
    { \keys_set:nn { dnd / table } {#1} }

  \par \vspace { 9pt plus 3pt minus 3pt } \noindent

  \tl_if_empty:NF \l__dnd_table_header_tl
    {
      \group_begin:
        \DndFontTableTitle \l__dnd_table_header_tl \nopagebreak
        \par \vspace{ 5pt plus 2pt minus 2pt } \noindent
      \group_end:
    }

  \DndFontTableBody

  \rowcolors {1} {} {\l__dnd_table_color_tl}

  \str_if_eq:VnTF \l__dnd_table_bold_tl { true }
  {
    \regex_extract_all:NnNTF \c__preamble_regex {#2} \l_tmpa_seq
    {
      \tl_set:Nn \l_tmpa_tl {\seq_use:Nn \l_tmpa_seq {^}}
      \use:x { \exp_not:n {\tabularx{\l__dnd_table_width_dim}}{`\l_tmpa_tl}}
      \rowstyle{\DndFontTableHeader}
    }
    {
      \tabularx {\l__dnd_table_width_dim} {#2}
    }
  }
  {
    \tabularx {\l__dnd_table_width_dim} {#2}
  }
}
{
  \endtabularx \vspace { 9pt plus 3pt minus 3pt }

  \group_end:
}

% Alternate table definition where the first row color is transparent,
% but then alternates the theme color and white, as per some source books.
\NewDocumentEnvironment {DndAltTable} { o m }
{
  \group_begin:

  \dim_set:Nn \l__dnd_table_width_dim { \linewidth }
  \tl_if_novalue:nF {#1}
    { \keys_set:nn { dnd / table } {#1} }

  \par \vspace { 9pt plus 3pt minus 3pt } \noindent

  \tl_if_empty:NF \l__dnd_table_header_tl
    {
      \group_begin:
        \DndFontTableTitle \l__dnd_table_header_tl \nopagebreak
        \par \vspace{ 5pt plus 2pt minus 2pt } \noindent
      \group_end:
    }

  \DndFontTableBody

  \rowcolors {2} {white} {\l__dnd_table_color_tl}

  \str_if_eq:VnTF \l__dnd_table_bold_tl { true }
  {
    \regex_extract_all:NnNTF \c__preamble_regex {#2} \l_tmpa_seq
    {
      \tl_set:Nn \l_tmpa_tl {\seq_use:Nn \l_tmpa_seq {^}}
      \use:x { \exp_not:n {\tabularx{\l__dnd_table_width_dim}}{`\l_tmpa_tl}}
      \rowstyle{\DndFontTableHeader}
    }
    {
      \tabularx {\l__dnd_table_width_dim} {#2}
    }
  }
  {
    \tabularx {\l__dnd_table_width_dim} {#2}
  }
}
{
  \endtabularx \vspace { 9pt plus 3pt minus 3pt }

  \group_end:
}

%%%%%%%%%%%%% START "dndlongtable" CODE %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Normally, @ is not a valid character in macro names. Make the @ symbol a
% normal letter in order to call an internal command from the dnd package.
% See <https://tex.stackexchange.com/a/8353> for more information.
\makeatletter
\NewDocumentEnvironment{dndlongtable}{O{>{\centering}p{0.2\linewidth} p{0.7\linewidth}} O{tablecolor}}{%
  % End horizontal mode. Pad the top of the table with some vertical space.
  \par\vspace*{8pt}
  % Disable indentation on the next line.
  \noindent
  % Set the sans-serif table body font.
  \DndFontTableBody
  % Set alternating row colours.
  \rowcolors{1}{#2}{}
  % Create a `supertabular*` table as wide as the current line (column) and pass
  % the column spec to it (#1).
  \begin{supertabular*}{\linewidth}{#1}
}{%
  \end{supertabular*}
  % Pad the bottom of the table with some vertical space.
  \vspace{8pt plus 1pt}
  % Disable indentation on the next line.
  \noindent
}
% Disable the @ character in macro names again.
\makeatother
%%%%%%%%%%%%% END "dndlongtable" CODE %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%%%%%%%%%%%% START "DndLongTable" CODE %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% A DndTable that breaks across columns and pages, repeating its column labels
% after each break. It takes DndTable's column specification: the body is
% first set in a hidden tabularx to find each column's width, then in a
% supertabular with those widths, so each part of the table is as wide as the
% whole. l, c and r columns keep their natural width; X and Y columns share
% the rest.

% A column with its prefix and one argument, such as >{\bfseries}X or p{2cm}
\regex_const:Nn \c__dnd_longtable_column_regex
  { (?: > \s* \{ [^{}]* \} \s* )? [^\s{}] (?: \s* \{ [^{}]* \} )? }
% A column split into its prefix and its type
\regex_const:Nn \c__dnd_longtable_prefix_regex
  { \A ( (?: > \s* \{ [^{}]* \} \s* )? ) (.*) \Z }

\keys_define:nn { dnd / longtable }
  {
    color .tl_set:N          = \l__dnd_longtable_color_tl,
    color .initial:n         = tablecolor,
    color .value_required:n  = true,
    header .tl_set:N         = \l__dnd_longtable_header_tl,
    header .value_required:n = true,
    width .dim_set:N         = \l__dnd_longtable_width_dim,
    width .value_required:n  = true,
  }

\seq_new:N \l__dnd_longtable_columns_seq
\tl_new:N \l__dnd_longtable_measure_tl
\tl_new:N \l__dnd_longtable_spec_tl
\box_new:N \l__dnd_longtable_cell_box
\box_new:N \l__dnd_longtable_table_box

\cs_new_protected:Npn \__dnd_longtable_width:n #1
  { g__dnd_longtable_column_ \int_to_arabic:n {#1} _dim }

% Measuring an l, c or r cell: its natural width, the widest so far
\cs_new_protected:Npn \__dnd_longtable_cell_begin:
  { \hbox_set:Nw \l__dnd_longtable_cell_box }
\cs_new_protected:Npn \__dnd_longtable_cell_end:n #1
  {
    \hbox_set_end:
    \dim_gset:cn { \__dnd_longtable_width:n {#1} }
      {
        \dim_max:nn
          { \dim_use:c { \__dnd_longtable_width:n {#1} } }
          { \box_wd:N \l__dnd_longtable_cell_box }
      }
    \box_use_drop:N \l__dnd_longtable_cell_box
  }
% Measuring an X or Y cell: the width tabularx gave it
\cs_new_protected:Npn \__dnd_longtable_stretch:n #1
  { \dim_gset:cn { \__dnd_longtable_width:n {#1} } { \hsize } }

% Build the measuring and final specifications from the columns
\cs_new_protected:Npn \__dnd_longtable_specs:n #1
  {
    \regex_extract_all:NnN \c__dnd_longtable_column_regex {#1}
      \l__dnd_longtable_columns_seq
    \tl_clear:N \l__dnd_longtable_measure_tl
    \tl_clear:N \l__dnd_longtable_spec_tl
    \seq_map_indexed_inline:Nn \l__dnd_longtable_columns_seq
      {
        \dim_if_exist:cF { \__dnd_longtable_width:n {##1} }
          { \dim_new:c { \__dnd_longtable_width:n {##1} } }
        \dim_gzero:c { \__dnd_longtable_width:n {##1} }
        \regex_extract_once:NnN \c__dnd_longtable_prefix_regex {##2} \l_tmpa_seq
        \tl_set:Nx \l_tmpa_tl { \seq_item:Nn \l_tmpa_seq { 2 } }
        \tl_set:Nx \l_tmpb_tl { \seq_item:Nn \l_tmpa_seq { 3 } }
        \tl_put_right:Nn \l__dnd_longtable_measure_tl { ^ }
        \tl_put_right:Nn \l__dnd_longtable_spec_tl { ^ }
        \str_case_e:nnF { \tl_to_str:N \l_tmpb_tl }
          {
            { l } { \__dnd_longtable_fixed:nnn {##1} { l } { \raggedright } }
            { c } { \__dnd_longtable_fixed:nnn {##1} { c } { \centering } }
            { r } { \__dnd_longtable_fixed:nnn {##1} { r } { \raggedleft } }
            { X } { \__dnd_longtable_stretch:nn {##1} { } }
            { Y } { \__dnd_longtable_stretch:nn {##1} { \centering } }
          }
          {
            % Any other column keeps its own width
            \tl_put_right:Nx \l__dnd_longtable_measure_tl { \exp_not:n {##2} }
            \tl_put_right:Nx \l__dnd_longtable_spec_tl { \exp_not:n {##2} }
          }
      }
    % The first ^ is DndTable's ` column, which resets the row style
    \tl_set:Nx \l__dnd_longtable_measure_tl
      { ` \tl_tail:N \l__dnd_longtable_measure_tl }
    \tl_set:Nx \l__dnd_longtable_spec_tl
      { ` \tl_tail:N \l__dnd_longtable_spec_tl }
  }
% Column #1, of alignment #2: measured as it is, then that wide and no wider
\cs_new_protected:Npn \__dnd_longtable_fixed:nnn #1 #2 #3
  {
    \tl_put_right:Nx \l__dnd_longtable_measure_tl
      {
        \exp_not:V \l_tmpa_tl
        > { \exp_not:N \__dnd_longtable_cell_begin: } #2
        < { \exp_not:N \__dnd_longtable_cell_end:n {#1} }
      }
    \tl_put_right:Nx \l__dnd_longtable_spec_tl
      {
        \exp_not:V \l_tmpa_tl
        w {#2} { \exp_not:N \dim_use:c { \__dnd_longtable_width:n {#1} } }
      }
  }
% Column #1, stretched: measured as tabularx sets it, then a paragraph that wide
\cs_new_protected:Npn \__dnd_longtable_stretch:nn #1 #2
  {
    \tl_put_right:Nx \l__dnd_longtable_measure_tl
      {
        \exp_not:V \l_tmpa_tl
        > { \exp_not:N \__dnd_longtable_stretch:n {#1} \exp_not:n {#2} } X
      }
    \tl_put_right:Nx \l__dnd_longtable_spec_tl
      {
        \exp_not:V \l_tmpa_tl
        > { \exp_not:n { #2 \arraybackslash } }
        p { \exp_not:N \dim_use:c { \__dnd_longtable_width:n {#1} } }
      }
  }

% The next row is row 1 and has no colour. colortbl picks a row's colour at
% the end of the row before, so after a break the new column's first row would
% otherwise take its colour from the count before the break.
\cs_new:Npn \__dnd_longtable_restart_rows:
  {
    \noalign
      {
        \int_gset:Nn \rownum { 1 }
        \cs_gset_eq:cN { CT@row@color } \relax
      }
  }

% DndLongTable [color, header, width] {column spec} {column labels}
\NewDocumentEnvironment {DndLongTable} { o m m +b }
  {
    \group_begin:
    \dim_set:Nn \l__dnd_longtable_width_dim { \linewidth }
    \tl_if_novalue:nF {#1}
      { \keys_set:nn { dnd / longtable } {#1} }

    \par \vspace { 9pt plus 3pt minus 3pt } \noindent

    \tl_if_empty:NF \l__dnd_longtable_header_tl
      {
        \group_begin:
          \DndFontTableTitle \l__dnd_longtable_header_tl \nopagebreak
          \par \vspace{ 5pt plus 2pt minus 2pt } \noindent
        \group_end:
      }

    \DndFontTableBody
    \__dnd_longtable_specs:n {#2}

    % Set the whole table once, unseen, to measure its columns
    \hbox_set:Nn \l__dnd_longtable_table_box
      {
        % tabularx finds its body by its own \end, as DndLongTable's is gone
        \use:x
          {
            \exp_not:N \begin {tabularx} { \dim_use:N \l__dnd_longtable_width_dim }
              { \exp_not:V \l__dnd_longtable_measure_tl }
          }
        \tl_if_blank:nF {#3} { \rowstyle { \DndFontTableHeader } #3 \\ }
        #4
        \end {tabularx}
      }

    % Each row resets the row style, which the labels set, as in DndTable
    \tl_if_blank:nTF {#3}
      { \tablehead { \__dnd_longtable_restart_rows: } }
      {
        \tablehead
          { \__dnd_longtable_restart_rows: \rowstyle { \DndFontTableHeader } #3 \\ }
      }
    \tabletail {}
    \tablelasttail {}
    \rowcolors {1} {} { \l__dnd_longtable_color_tl }
    % In vertical mode: supertabular sets a stray space in horizontal mode,
    % and starts its own line
    \par
    \use:x
      {
        \exp_not:N \begin {supertabular}
          { \exp_not:V \l__dnd_longtable_spec_tl }
      }
    #4
    \end {supertabular}
  }
  {
    \vspace { 9pt plus 3pt minus 3pt }
    \group_end:
  }
%%%%%%%%%%%%% END "DndLongTable" CODE %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%%%%%%%%%%%% START "ornamented table" CODE %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Code from Loop Space: <https://tex.stackexchange.com/a/26386/73317>
\ExplSyntaxOff
\makeatletter
\tikzset{
  use path for main/.code={%
    \tikz@addmode{%
      \expandafter\pgfsyssoftpath@setcurrentpath\csname tikz@intersect@path@name@#1\endcsname
    }%
  },
  use path for actions/.code={%
    \expandafter\def\expandafter\tikz@preactions\expandafter{\tikz@preactions\expandafter\let\expandafter\tikz@actions@path\csname tikz@intersect@path@name@#1\endcsname}%
  },
  use path/.style={%
    use path for main=#1,
    use path for actions=#1,
  }
}
\makeatother
% End of the code from Loop Space

% Ornamented box content from: https://tex.stackexchange.com/a/501736/2575
\tikzset{ornamented frame inner/.style={color=ornamentedframeinner,
                                        line width=2pt},
         ornamented frame outer/.style={color=ornamentedframeouter,
                                        line width=3pt}}

\tcbsubskin{ornamented}{empty}{
  skin first=ornamented, skin middle=ornamented, skin last=ornamented,
  title engine=standard,
  frame code={
    % Account for the line widths in order not to draw beyond the bounding
    % box---except for a few very small details for which this is intentional.
    \coordinate (north west) at ([shift={(-1.5pt,9.5pt)}]frame.north west);
    \coordinate (north east) at ([shift={(1.5pt,9.5pt)}]frame.north east);
    \coordinate (south east) at ([shift={(1.5pt,-9.5pt)}]frame.south east);
    \coordinate (south west) at ([shift={(-1.5pt,-9.5pt)}]frame.south west);
    %
    \foreach \xoffset/\point in {34pt/north west, -34pt/north east,
                                  34pt/south west, -34pt/south east} {
      \fill[color=ornamentedframeouter]
        ([xshift=\xoffset]\point) circle[radius=2.5pt];
    }
    %
    \path[name path=ornament 1]  ([yshift=-4pt]north west)
      [rounded corners=0.5pt] -- ++(23pt,0)
      [rounded corners=2pt]   -- ++(3pt,-4pt)
                              -- ([shift={(-26pt,-8pt)}]north east)
      [rounded corners=0.5pt] -- ++(3pt,4pt)
      [rounded corners=4pt]   -- ([yshift=-4pt]north east)
                              -- ([yshift=4pt]south east)
      [rounded corners=0.5pt] -- ++(-23pt,0)
      [rounded corners=2pt]   -- ++(-3pt,4pt)
                              -- ([shift={(26pt,8pt)}]south west)
      [rounded corners=0.5pt] -- ++(-3pt,-4pt)
      [rounded corners=4pt]   -- ([yshift=4pt]south west)
                              -- cycle;
    %
    \path[rounded corners=0.5pt, name path=ornament 2]
                                 ([yshift=-20pt]north west)
                              -- ++(-4pt,3pt)
                              -- ++(0,4pt)
               to[out=0, in=-90] ([shift={(8pt,0pt)}]north west)
                              -- ([shift={(34pt,0pt)}]north west)
                              -- ([shift={(-8pt,0pt)}]north east)
             to[out=-90, in=180] ([shift={(4pt,-13pt)}]north east)
                              -- ++(0,-4pt)
                              -- ++(-4pt,-3pt)
                              -- ([yshift=20pt]south east)
                              -- ++(4pt,-3pt)
                              -- ++(0,-4pt)
              to[out=180, in=90] ([shift={(-8pt,0pt)}]south east)
                              -- ([shift={(8pt,0pt)}]south west)
                to[out=90, in=0] ([shift={(-4pt,13pt)}]south west)
                              -- ++(0,4pt)
                              -- ++(4pt,3pt)
                              -- cycle;
    %
    \draw[ornamented frame outer, use path=ornament 1,fill=white];
    \draw[ornamented frame outer, use path=ornament 2];
    \draw[ornamented frame inner, use path=ornament 1];
    \draw[ornamented frame inner, use path=ornament 2];
    %
    \foreach \xoffset/\point in {34pt/north west, -34pt/north east,
                                 34pt/south west, -34pt/south east} {
      \fill[color=ornamentedframeinner]
        ([xshift=\xoffset]\point) circle[radius=2pt];
    }
  }
}

% These parameters---especially those related to geometry---are better located
% here in a style than in the subskin definition (see the Subskins section of
% the tcolorbox manual).
\tcbset{ornamented/.style={skin=ornamented, coltitle=black, toptitle=5pt,
                           % Reserve vertical space for the decorations---space
                           % that disappears at page breaks.
                           beforeafter skip=28pt}
}
%%%%%%%%%%%%% END "ornamented table" CODE %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Define the 'ornamentedbox' environment
\newtcolorbox{ornamentedbox}[1][]{ornamented, fonttitle=\DndFontTableTitle,top=2pt,bottom=2pt,left=0pt,right=0pt, #1}

% Convenient style to use with a tcolorbox preceded by text (or anything),
% when one wants to prevent any page break before the tcolorbox.
\tcbset{skip and no break/.style={
  before={\par\nopagebreak\vspace{4ex}\noindent}}
}

% Style suitable for an “on line” (in the middle of a paragraph)
% 'ornamentedbox'.
\tcbset{
  my on line/.style={capture=hbox, tcbox raise base,
    % Reserve horizontal space for the decorations---space that disappears at
    % line breaks.
    before={\hspace{8pt}},
    after={\hspace{8pt}\vspace{18pt}% Automatically add vspace *after* the line.
    },                              % This can't be done for the “before”
  }                                 % vspace, because when an “on line” box is
}                                   % seen by TeX, it is too late.

\ExplSyntaxOn

\box_new:N \l__panicmode_tmp_box

\NewDocumentEnvironment { ornamentedtabular } { O{} m O{} }
  {
    \hbox_set:Nw \l__panicmode_tmp_box
    \rowcolors { 2 } { \l__dnd_table_color_tl } { white }
    \group_begin:
    \DndFontTableBody
    \tabular [#1] {#2}
  }
  {
    \endtabular
    \group_end:
    \hbox_set_end:
    \begin{ornamentedbox} [#3]
    \box_use_drop:N \l__panicmode_tmp_box
    \end{ornamentedbox}
  }

\ExplSyntaxOff

